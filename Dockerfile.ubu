ARG UBUNTU_DIST=noble
FROM ubuntu:$UBUNTU_DIST

ARG UBUNTU_DIST
ARG rumdl_VERSION
ARG BUILD_VERSION
ARG FULL_VERSION
ARG ARCH
ARG RUMDL_RELEASE

RUN mkdir -p /output/usr/bin
RUN mkdir -p /output/usr/share/doc/rumdl
RUN mkdir -p /output/usr/share/bash-completion/completions
RUN mkdir -p /output/usr/share/fish/vendor_completions.d
RUN mkdir -p /output/usr/share/zsh/vendor-completions
RUN mkdir -p /output/DEBIAN

COPY ${RUMDL_RELEASE}/rumdl /output/usr/bin/rumdl
# Completions are generated by build_*.sh from the amd64 binary; they are
# architecture independent.
COPY completions/rumdl.bash /output/usr/share/bash-completion/completions/rumdl
COPY completions/rumdl.fish /output/usr/share/fish/vendor_completions.d/rumdl.fish
COPY completions/_rumdl /output/usr/share/zsh/vendor-completions/_rumdl
RUN chmod 755 /output/usr/bin/rumdl
# The files copied in from the build host inherit its umask; normalise them
# so the package never ships group-writable files.
RUN chmod 644 /output/usr/share/bash-completion/completions/rumdl \
      /output/usr/share/fish/vendor_completions.d/rumdl.fish \
      /output/usr/share/zsh/vendor-completions/_rumdl
COPY output/DEBIAN/control /output/DEBIAN/
COPY output/DEBIAN/postinst /output/DEBIAN/postinst
RUN chmod 755 /output/DEBIAN/postinst
COPY output/copyright /output/usr/share/doc/rumdl/
COPY output/changelog.Debian /output/usr/share/doc/rumdl/
COPY output/README.md /output/usr/share/doc/rumdl/
RUN chmod 644 /output/usr/share/doc/rumdl/*

RUN sed -i "s/DIST/$UBUNTU_DIST/" /output/usr/share/doc/rumdl/changelog.Debian
RUN sed -i "s/FULL_VERSION/$FULL_VERSION/" /output/usr/share/doc/rumdl/changelog.Debian
RUN sed -i "s/DIST/$UBUNTU_DIST/" /output/DEBIAN/control
RUN sed -i "s/rumdl_VERSION/$rumdl_VERSION/" /output/DEBIAN/control
RUN sed -i "s/BUILD_VERSION/$BUILD_VERSION/" /output/DEBIAN/control
RUN sed -i "s/SUPPORTED_ARCHITECTURES/$ARCH/" /output/DEBIAN/control

RUN dpkg-deb --build /output /rumdl_${FULL_VERSION}.deb
